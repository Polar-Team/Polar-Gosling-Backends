# Dockerfile for MotherGoose Backend
# Multi-stage UV-optimized build for production
# Supports multi-platform: linux/amd64, linux/arm64

ARG UV_VERSION="0.11"

# --- Pinned apt package versions (Debian Trixie / 13) ---
# Builder stage
ARG BUILD_ESSENTIAL_VERSION="12.12"
ARG GIT_VERSION_BUILD="1:2.47.3-0+deb13u1"
# Runtime stage
ARG CA_CERTIFICATES_VERSION="20250419"
ARG CURL_VERSION="8.14.1-2+deb13u4"
ARG GIT_VERSION_RUNTIME="1:2.47.3-0+deb13u1"
ARG PROCPS_VERSION="2:4.0.4-9"
ARG TINI_VERSION="0.19.0-3+b7"

# ---------------------------------------------------------------------------
# Stage 1: Build — install dependencies in an isolated venv using uv
# ---------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:${UV_VERSION}-python3.13-trixie-slim AS builder

WORKDIR /app

# Enable bytecode compilation for faster cold-start
ENV UV_COMPILE_BYTECODE=1 \
  UV_LINK_MODE=copy

# Install system build dependencies (grpcio, gitpython, etc.)
ARG BUILD_ESSENTIAL_VERSION
ARG GIT_VERSION_BUILD
RUN apt-get update && apt-get install -y --no-install-recommends \
  build-essential=${BUILD_ESSENTIAL_VERSION} \
  git=${GIT_VERSION_BUILD} \
  && rm -rf /var/lib/apt/lists/*

# Copy dependency manifests first — maximises Docker layer cache hits
COPY mothergoose/pyproject.toml mothergoose/uv.lock ./

# Install production dependencies only (no dev/test/format/style/type groups)
# --no-install-project: skip installing the project itself (source not copied yet)
# --frozen: respect the lockfile exactly
RUN --mount=type=cache,target=/root/.cache/uv \
  uv sync --frozen --no-install-project --no-dev

# Copy application source and install the project
COPY mothergoose/src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
  uv sync --frozen --no-dev

# ---------------------------------------------------------------------------
# Stage 2: Runtime — minimal production image
# ---------------------------------------------------------------------------
FROM python:3.13-slim-trixie AS runtime

WORKDIR /app

# Install only the runtime system packages we need
ARG CA_CERTIFICATES_VERSION
ARG CURL_VERSION
ARG GIT_VERSION_RUNTIME
ARG PROCPS_VERSION
ARG TINI_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates=${CA_CERTIFICATES_VERSION} \
  curl=${CURL_VERSION} \
  git=${GIT_VERSION_RUNTIME} \
  procps=${PROCPS_VERSION} \
  tini=${TINI_VERSION} \
  && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 1000 mothergoose && \
  useradd -m -u 1000 -g mothergoose mothergoose && \
  chown -R mothergoose:mothergoose /app

# Copy the pre-built virtual environment from builder
COPY --from=builder --chown=mothergoose:mothergoose /app/.venv /app/.venv

# Copy application source
COPY --chown=mothergoose:mothergoose mothergoose/src /app/src
COPY --chown=mothergoose:mothergoose mothergoose/pyproject.toml /app/

# Put the venv on PATH so `python`, `uvicorn`, `celery` resolve correctly
ENV PATH="/app/.venv/bin:$PATH" \
  PYTHONUNBUFFERED=1 \
  PYTHONDONTWRITEBYTECODE=1 \
  MOTHERGOOSE_ENVIRONMENT=production

# Switch to non-root user
USER mothergoose

# Health check — FastAPI /health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

# Use tini as PID 1 for proper signal handling
ENTRYPOINT ["tini", "--"]

# Default: run the FastAPI application
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# Override examples:
#   Celery worker:  celery -A app.celery_worker worker --loglevel=info -Q mothergoose
#   Celery beat:    celery -A app.celery_worker beat --loglevel=info
