# Dockerfile for UglyFox Backend
# Multi-stage UV-optimized build for production
# Supports multi-platform: linux/amd64, linux/arm64

# ---------------------------------------------------------------------------
# Stage 1: Build — install dependencies in an isolated venv using uv
# ---------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:0.11-python3.13-trixie-slim AS builder

WORKDIR /app

# Enable bytecode compilation for faster cold-start
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Install system build dependencies (grpcio, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency manifests first — maximises Docker layer cache hits
COPY uglyfox/pyproject.toml uglyfox/uv.lock ./

# Install production dependencies only (no dev/test/format/style/type groups)
# --no-install-project: skip installing the project itself (source not copied yet)
# --frozen: respect the lockfile exactly
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

# Copy application source and install the project
COPY uglyfox/src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# ---------------------------------------------------------------------------
# Stage 2: Runtime — minimal production image
# ---------------------------------------------------------------------------
FROM python:3.13-slim-trixie AS runtime

WORKDIR /app

# Install only the runtime system packages we need
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    procps \
    tini \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 1000 uglyfox && \
    useradd -m -u 1000 -g uglyfox uglyfox && \
    chown -R uglyfox:uglyfox /app

# Copy the pre-built virtual environment from builder
COPY --from=builder --chown=uglyfox:uglyfox /app/.venv /app/.venv

# Copy application source
COPY --chown=uglyfox:uglyfox uglyfox/src /app/src
COPY --chown=uglyfox:uglyfox uglyfox/pyproject.toml /app/

# Put the venv on PATH so `python`, `celery` resolve correctly
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UGLYFOX_ENVIRONMENT=production

# Switch to non-root user
USER uglyfox

# Health check — verify celery worker process is alive
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD pgrep -f "celery.*worker" || exit 1

# Use tini as PID 1 for proper signal handling
ENTRYPOINT ["tini", "--"]

# Default: run the Celery worker
CMD ["celery", "-A", "app.celery_worker", "worker", "--loglevel=info", "-Q", "uglyfox"]

# Override examples:
#   Debug mode:     celery -A app.celery_worker worker --loglevel=debug -Q uglyfox
#   Single worker:  celery -A app.celery_worker worker --loglevel=info -Q uglyfox --concurrency=1
