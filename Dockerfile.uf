# Dockerfile for UglyFox Backend
# Multi-stage build for optimized production image

FROM python:3.13-slim AS builder

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast package management
RUN pip install --no-cache-dir uv

# Copy dependency files
COPY uglyfox/pyproject.toml uglyfox/uv.lock ./

# Install dependencies using uv
RUN uv sync --frozen --no-dev

# Production stage
FROM python:3.13-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 uglyfox && \
    chown -R uglyfox:uglyfox /app

# Copy virtual environment from builder
COPY --from=builder --chown=uglyfox:uglyfox /app/.venv /app/.venv

# Copy application code
COPY --chown=uglyfox:uglyfox uglyfox/src /app/src
COPY --chown=uglyfox:uglyfox uglyfox/pyproject.toml /app/

# Set environment variables
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UGLYFOX_ENVIRONMENT=production

# Switch to non-root user
USER uglyfox

# Health check (UglyFox is a worker, so check process)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD pgrep -f "celery.*worker" || exit 1

# Default command: Run Celery worker
CMD ["celery", "-A", "app.celery_worker", "worker", "--loglevel=info", "-Q", "uglyfox"]

# Alternative commands (override with docker run):
# Debug mode: celery -A app.celery_worker worker --loglevel=debug -Q uglyfox
# Single worker: celery -A app.celery_worker worker --loglevel=info -Q uglyfox --concurrency=1
