{% if mirrors and mirrors|length > 0 %}
provider_installation {
{% for mirror in mirrors %}
  network_mirror {
    url = "{{ mirror.url }}"
{% if mirror.include is defined and mirror.include|length > 0 %}
    include = {{ mirror.include }}
{% elif mirror.exclude is defined and mirror.exclude|length > 0 %}
    exclude = {{ mirror.exclude }}
{% endif %}
  }
{% endfor %}

{% if direct_exclude is defined and direct_exclude == true %}
  direct {
    exclude = ["registry.terraform.io/*/*"]
  }
{% endif %}
}
{% endif %}


