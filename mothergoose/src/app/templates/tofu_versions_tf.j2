terraform {
  backend "s3" {
    bucket = "{{ tofu_s3_bucket }}"
    key    = "{{ tofu_s3_key }}"
    region = "{{ tofu_s3_region }}"
    {% if tofu_s3_profile is defined and tofu_s3_profile|length > 0 %}profile = "{{ tofu_s3_profile }}"{% endif %}
    {% if tofu_s3_endpoint is defined and tofu_s3_endpoint|length > 0 %}endpoint = "{{ tofu_s3_endpoint }}"{% endif %}
    {% if tofu_s3_role_arn is defined and tofu_s3_role_arn|length > 0 %}role_arn = "{{ tofu_s3_role_arn }}"{% endif %}
    {% if tofu_s3_dynamodb_table is defined and tofu_s3_dynamodb_table|d('')|length > 0 %}dynamodb_table = "{{ tofu_s3_dynamodb_table }}"{% endif %}
  }
  required_version = {% if tofu_version is defined or tofu_version|d('')|length > 0 %}"{{ tofu_version }}"{% else %}">= 1.3.6"{% endif %}
  required_providers {
    local = {
      source  = "hashicorp/local"
      version = ">= 2.3.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = ">= 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = ">= 3.5"
    }
{% for provider in tofu_providers %}
    {{ provider.name }} = {
      source  = "{{ provider.source }}"
      version = "{{ provider.version }}"
    }
{% endfor %
  }
}

